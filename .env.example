# Copy to .env and fill in. Never commit the real .env.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

NODE_ENV=production
PORT=5000
TIMEZONE=UTC
# MongoDB settings
# For local development: docker compose -f docker-compose.dev.yml up -d, then use
# MONGO_URI=mongodb://localhost:27017/pingpilott
MONGO_URI=
# JWT settings
JWT_SECRET=
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
# Email settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
# Rate limiting
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=
AUTH_RATE_LIMIT_MAX=
# Monitoring settings
DEFAULT_CHECK_FREQUENCY=
DEFAULT_RESPONSE_THRESHOLD=
# Days of check history to keep, 1 to 30 (default 30, the longest view in the apps). Older checks are deleted at midnight.
CHECK_DATA_RETENTION_DAYS=
LOG_RETENTION_DAYS=
ADMIN_SETUP_TOKEN=
# Redis (BullMQ queues, cache, live updates)
REDIS_URL=redis://localhost:6379
ADMIN_EMAIL=

# Monitoring private addresses (localhost, 10.x, 192.168.x) is blocked so users cannot probe your network.
# Set to true ONLY on a development machine where you want to monitor local services.
ALLOW_PRIVATE_TARGETS=false

# Number of reverse proxies in front of the API (nginx = 1). Used for per-client rate limits.
TRUST_PROXY=1

# Hostnames are looked up on libuv's thread pool, which has 4 threads unless told otherwise. Checks run 50 at a time and
# a lookup for a dead name holds a thread until the resolver gives up, so lookups for healthy servers can queue behind it
# and show up as slow responses. Use 16. Unlike the other settings here this must be in the PROCESS environment (set on
# the host's dashboard, e.g. Render; Dockerfile and ecosystem.config.cjs already set it): a value in this file is read too
# late to change the pool. The monitor worker logs at start-up whether it was set.
# UV_THREADPOOL_SIZE=16

# A check is timed until its response is noticed, so if the worker's own event loop is stalled the check reads slower than
# the server was. A SLOW check measured while the loop was more than this many ms late is stored and shown, but is not
# counted toward a slow alert. 0 switches it off. The worker also logs one summary line a minute (DNS and loop lag).
LOOP_LAG_SUSPECT_MS=250

# Milliseconds a first failure waits before being re-checked and declared down (0 disables)
DOWN_CONFIRM_DELAY_MS=10000

# Set to true to require new accounts to verify their email before signing in (needs working SMTP)
REQUIRE_EMAIL_VERIFICATION=false

# The API process also runs the monitor and alert workers unless this is false (use false when they run as
# separate processes, as in docker-compose.yml and ecosystem.config.cjs)
RUN_WORKERS=true

# Optional dead-man's-switch: while monitoring is healthy the API pings this address once a minute, so an outside
# service (Healthchecks.io, Better Stack, an Uptime Kuma push monitor) can tell you when the pings stop, which also
# covers the whole host being down. Treat the address as a secret. Leave empty to switch it off.
HEARTBEAT_URL=
