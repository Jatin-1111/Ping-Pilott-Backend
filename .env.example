# Copy to .env and fill in. Never commit the real .env.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

NODE_ENV=production
PORT=5000
TIMEZONE=UTC
# MongoDB settings
MONGO_URI=
# JWT settings
JWT_SECRET=
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
# Email settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
# Rate limiting
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=
AUTH_RATE_LIMIT_MAX=
# Monitoring settings
DEFAULT_CHECK_FREQUENCY=
DEFAULT_RESPONSE_THRESHOLD=
# Data retention (days)
CHECK_DATA_RETENTION_DAYS=
LOG_RETENTION_DAYS=
ADMIN_SETUP_TOKEN=
# Smart monitoring configuration
SMART_MONITORING_ENABLED=true
PEAK_HOURS_START=
PEAK_HOURS_END=
MAX_CONCURRENT_CHECKS=
# Data retention mode: 'aggressive', 'selective', or 'emergency'
# - aggressive: Clears ALL data daily at midnight
# - selective: Keeps last 24 hours of data
# - emergency: Nuclear option - clears everything immediately
DATA_RETENTION_MODE=selective

# Redis (BullMQ queues, cache, live updates)
REDIS_URL=redis://localhost:6379
ADMIN_EMAIL=

# Monitoring private addresses (localhost, 10.x, 192.168.x) is blocked so users cannot probe your network.
# Set to true ONLY on a development machine where you want to monitor local services.
ALLOW_PRIVATE_TARGETS=false

# Number of reverse proxies in front of the API (nginx = 1). Used for per-client rate limits.
TRUST_PROXY=1

# Milliseconds a first failure waits before being re-checked and declared down (0 disables)
DOWN_CONFIRM_DELAY_MS=10000

# Set to true to require new accounts to verify their email before signing in (needs working SMTP)
REQUIRE_EMAIL_VERIFICATION=false
